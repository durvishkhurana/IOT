# Copy this file to .env and change the values.

# Shared secret the ESP32 sends in the X-API-Key header.
# Must match SERVER_API_KEY in firmware/rfid_door_servo/secrets.h
DEVICE_API_KEY=change-me-device-key

# Dashboard login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin123

# Random string used to sign the login cookie (any long random text)
SESSION_SECRET=replace-with-a-long-random-string
